# URL del proyecto Supabase (encontrado en: Project Settings > API)
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# Clave anónima de Supabase (encontrado en: Project Settings > API)
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-aqui

# Puerto en el que se ejecuta el servidor (Render/Railway lo asignan automáticamente)
PORT=3000

# Palabra secreta para el endpoint de limpieza (opcional, evita que cualquiera borre datos)
CLEANUP_SECRET=cambia-esto-por-una-palabra-secreta
